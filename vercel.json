{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/solov2/browser",
  "rewrites": [
    { "source": "/api/dealer/:endpoint", "destination": "/api/dealer?endpoint=:endpoint" },
    { "source": "/api/users/:id", "destination": "/api/users?id=:id" },
    { "source": "/api/states/:id", "destination": "/api/states?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
